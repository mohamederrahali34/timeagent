{
  "name": "timeagent",
  "version": "0.2.1",
  "description": "Undo coding-agent file changes without losing pre-existing local work.",
  "type": "module",
  "bin": {
    "timeagent": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "test": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node --test dist/**/*.test.js",
    "prepack": "npm run build",
    "start": "node dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "cli",
    "coding-agent",
    "checkpoint",
    "undo",
    "developer-tools"
  ],
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
